@model List<TheatreTicketSystem.Domain.Entities.Play>

@{
    ViewData["Title"] = "Претстави";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Претстави</h2>
    <a class="btn btn-success" asp-action="Create">+ Add New Play</a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">No plays found.</div>
}
else
{
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Poster</th>
                <th>Title</th>
                <th>Genre</th>
                <th>Duration</th>
                <th style="width:220px;">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in Model)
            {
                <tr>
                    <td style="width:120px;">
                        @if (!string.IsNullOrWhiteSpace(p.PosterImagePath))
                        {
                            <img src="@p.PosterImagePath" style="width:110px;height:70px;object-fit:cover;border-radius:8px;" />
                        }
                        else
                        {
                            <span class="text-muted">No image</span>
                        }
                    </td>
                    <td>@p.Title</td>
                    <td>@p.Genre</td>
                    <td>@p.DurationMinutes min</td>
                    <td>
                        <a class="btn btn-sm btn-primary" asp-action="Edit" asp-route-id="@p.Id">Edit</a>
                        <a class="btn btn-sm btn-danger" asp-action="Delete" asp-route-id="@p.Id">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
