@model TheatreTicketSystem.Domain.Entities.Play

@{
    ViewData["Title"] = "Delete";
}

<h2>Delete</h2>

<div class="alert alert-warning mt-3">
    Are you sure you want to delete this play?
</div>

<div class="card p-3">
    <h4>@Model.Title</h4>
    <p class="text-muted">@Model.Genre • @Model.DurationMinutes min</p>
    <p>@Model.Description</p>

    @if (!string.IsNullOrWhiteSpace(Model.PosterImagePath))
    {
        <img src="@Model.PosterImagePath" style="width:300px;height:180px;object-fit:cover;border-radius:10px;" />
    }

    <form asp-action="DeleteConfirmed" method="post" class="mt-3">
        <input type="hidden" name="id" value="@Model.Id" />
        <button type="submit" class="btn btn-danger">Yes</button>
        <a asp-action="Index" class="btn btn-secondary ms-2">Cancel</a>
    </form>
</div>
