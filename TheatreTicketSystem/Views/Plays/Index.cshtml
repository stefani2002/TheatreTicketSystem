@model List<TheatreTicketSystem.Domain.Entities.Play>

<div class="landing-wrap">
    <div class="landing-card glass-card">
        <div id="playsCarousel" class="carousel slide" data-bs-ride="carousel" data-bs-interval="4500" data-bs-pause="false">
            <div class="carousel-inner">

                @for (int i = 0; i < Model.Count; i++)
                {
                    var play = Model[i];
                    <div class="carousel-item @(i == 0 ? "active" : "")">
                        <div class="landing-slide">

                            <div class="landing-poster">
                                @if (!string.IsNullOrEmpty(play.PosterImagePath))
                                {
                                    <img src="@play.PosterImagePath" alt="poster" />
                                }
                                else
                                {
                                    <div class="no-poster">No image</div>
                                }
                            </div>

                            <div class="landing-info">
                                <h3 class="landing-title">@play.Title</h3>

                                <div class="landing-meta">
                                    <span class="badge bg-secondary">@play.Genre</span>
                                    <span class="ms-2 text-muted">@play.DurationMinutes min</span>
                                </div>

                                <p class="landing-desc">
                                    @play.Description
                                </p>

                                <div class="landing-actions">
                                    <a class="btn btn-danger"
                                       asp-controller="Plays"
                                       asp-action="Details"
                                       asp-route-id="@play.Id">
                                        Детали
                                    </a>

                                    <a class="btn btn-danger"
                                       asp-controller="Repertoire"
                                       asp-action="Index">
                                        Репертоар
                                    </a>
                                </div>
                            </div>

                        </div>
                    </div>
                }

            </div>

            <button class="carousel-control-prev" type="button" data-bs-target="#playsCarousel" data-bs-slide="prev">
                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Previous</span>
            </button>

            <button class="carousel-control-next" type="button" data-bs-target="#playsCarousel" data-bs-slide="next">
                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Next</span>
            </button>

        </div>
    </div>
</div>
