@model TheatreTicketSystem.Domain.Entities.Show
@{
    ViewData["Title"] = "Delete";
}

<h2>Delete Show</h2>

<div class="alert alert-warning mt-3">
    Are you sure you want to delete this show?
</div>

<div class="card p-3">
    <p><strong>Датум:</strong> @Model.ShowTime.ToString("dd.MM.yyyy HH:mm")</p>
    <p><strong>Цена:</strong> @Model.Price MKD</p>
    <p><strong>Седишта:</strong> @Model.AvailableSeats / @Model.TotalSeats</p>

    <form asp-action="DeleteConfirmed" method="post" class="mt-3">
        <input type="hidden" name="id" value="@Model.Id" />
        <button type="submit" class="btn btn-danger">Yes</button>
        <a class="btn btn-secondary ms-2" asp-action="Index" asp-route-playId="@Model.PlayId">Cancel</a>
    </form>
</div>
