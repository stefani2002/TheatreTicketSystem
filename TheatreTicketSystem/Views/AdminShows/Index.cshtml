@model List<TheatreTicketSystem.Domain.Entities.Show>
@{
    ViewData["Title"] = "Закажи претстава";
    var playId = (Guid)ViewBag.PlayId;
    var playTitle = ViewBag.PlayTitle as string;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2>Закажи претстава</h2>
        <div class="text-muted">Име на претстава: <strong>@playTitle</strong></div>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-success" asp-action="Create" asp-route-playId="@playId">+ Add Show</a>
        <a class="btn btn-secondary" asp-controller="AdminPlays" asp-action="Index">Back to Plays</a>
    </div>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">No shows yet.</div>
}
else
{
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Датум</th>
                <th>Цена</th>
                <th>Вкупен број на седишта</th>
                <th>Слободни седишта</th>
                <th style="width:220px;"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var s in Model)
            {
                <tr>
                    <td>@s.ShowTime.ToString("dd.MM.yyyy HH:mm")</td>
                    <td>@s.Price MKD</td>
                    <td>@s.TotalSeats</td>
                    <td>@s.AvailableSeats</td>
                    <td>
                        <a class="btn btn-sm btn-primary" asp-action="Edit" asp-route-id="@s.Id">Edit</a>
                        <a class="btn btn-sm btn-danger" asp-action="Delete" asp-route-id="@s.Id">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
