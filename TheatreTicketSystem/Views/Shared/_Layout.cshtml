<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TheatreTicketSystem</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TheatreTicketSystem.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        @{
            var path = Context.Request.Path.Value?.ToLower() ?? "";
            string Active(string startsWith)
            => path.StartsWith(startsWith.ToLower()) ? "active" : "";
        }

        <nav class="navbar navbar-expand-sm theatre-nav mb-3">
            <div class="container-fluid position-relative">

                
                <div class="d-flex align-items-center">
                    <a class="navbar-brand d-flex align-items-center gap-2"
                       asp-controller="Plays" asp-action="Index">
                        <span class="theatre-logo">
                            <img src="~/images/logo.png" alt="TheatreTicketSystem logo" />
                        </span>
                        <span class="fw-bold">МОЈ ТЕАТАР</span>
                    </a>
                </div>

                
                <div class="collapse navbar-collapse justify-content-center" id="mainNav">
                    <ul class="navbar-nav gap-2">
                        <li class="nav-item">
                            <a class="nav-link @Active("/")"
                               asp-controller="Home" asp-action="Index">Претстави</a>
                        </li>
                        
                        <li class="nav-item">
                            <a class="nav-link @Active("/repertoire")"
                               asp-controller="Repertoire" asp-action="Index">Репертоар</a>
                        </li>

                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link @Active("/adminplays")"
                                   asp-controller="AdminPlays" asp-action="Index">Admin</a>
                            </li>
                        }
                    </ul>
                </div>

                
                <div class="d-flex align-items-center ms-auto gap-2">
                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        <span class="nav-user">Hello, @User.Identity.Name</span>

                        <form asp-area="Identity"
                              asp-page="/Account/Logout"
                              method="post">
                            <button type="submit" class="nav-logout-btn">Logout</button>
                        </form>
                    }
                    else
                    {
                        <a class="nav-link nav-pill"
                           asp-area="Identity"
                           asp-page="/Account/Login">Login</a>

                        <a class="nav-link nav-pill"
                           asp-area="Identity"
                           asp-page="/Account/Register">Register</a>
                    }
                </div>

                
                <button class="navbar-toggler position-absolute end-0 me-3"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNav"
                        aria-controls="mainNav"
                        aria-expanded="false"
                        aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

            </div>
        </nav>


    </header>

    <div class="container">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="site-footer">
        <div class="container footer-inner">
            <div class="row g-4">
                <div class="col-md-4">
                    <div class="footer-title">About Us</div>
                    <div class="footer-item mt-2">
                        Брзо, едноставно и без чекање редици! Купи билет онлајн.
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="footer-title">Контакт</div>
                    <div class="footer-item mt-2">📞 Телефон: +389 70 123 456</div>
                    <div class="footer-item">📍 Локација: Skopje, Macedonia</div>
                    <div class="footer-item">✉️ Email: info@mojteatar.com</div>
                </div>

                <div class="col-md-4">
                    <div class="footer-title">Social</div>
                    <div class="footer-item mt-2">
                        <a class="footer-link" href="#" target="_blank">Instagram</a> ·
                        <a class="footer-link" href="#" target="_blank">Facebook</a> ·
                        <a class="footer-link" href="#" target="_blank">TikTok</a>
                    </div>
                    <div class="footer-item mt-2">
                        &copy; 2026 МојТеатар
                    </div>
                </div>
            </div>
        </div>
    </footer>


    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

    <!-- Chatbot -->
    <div id="chatbot" class="chatbot">
        <button id="chatbot-btn" class="chatbot__fab" type="button" aria-label="Open chat">
            <span class="chatbot__fabIcon">💬</span>
        </button>

        <div id="chatbot-popup" class="chatbot__panel chatbot-hidden" role="dialog" aria-modal="true" aria-label="Theatre AI Assistant">
            <div class="chatbot__header">
                <div class="chatbot__titlewrap">
                    <div class="chatbot__avatar">🎭</div>
                    <div>
                        <div class="chatbot__title">Theatre AI Assistant</div>
                        <div class="chatbot__subtitle">Ask about plays, showtimes & tickets</div>
                    </div>
                </div>

                <button id="chatbot-close" class="chatbot__close" type="button" aria-label="Close chat">✕</button>
            </div>

            <div id="chatbot-messages" class="chatbot__messages"></div>

            <div class="chatbot__composer">
                <input id="chatbot-text" class="chatbot__input" type="text" placeholder="Type your question..." autocomplete="off" />
                <button id="chatbot-send" class="chatbot__send" type="button">Send</button>
            </div>
        </div>
    </div>

</body>
</html>
